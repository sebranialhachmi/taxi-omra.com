# =============================================================================
# Jeddah Travels — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values for your environment.
# Variables prefixed with VITE_ are exposed to the client bundle.
# All other variables are server-only (server functions, SSR, edge routes).
# -----------------------------------------------------------------------------


# ------------------------------------------------------------------ #
# SITE / BRAND  (all optional — sane fallbacks live in src/lib/site-info.ts)
# ------------------------------------------------------------------ #
# The public canonical origin. Changing this single value re-brands
# every canonical URL, sitemap entry, robots.txt, and JSON-LD.
VITE_SITE_URL=https://mazarat-sa.online                # optional — public origin (no trailing slash)

VITE_SITE_BRAND_EN=Omra Taxi                            # optional — English brand name
VITE_SITE_BRAND_AR=عمرة تاكسي                           # optional — Arabic brand name
VITE_SITE_LEGAL_EN=Omra Taxi                            # optional — legal entity (EN)
VITE_SITE_LEGAL_AR=عمرة تاكسي                           # optional — legal entity (AR)
VITE_SITE_TAGLINE_EN=Premium chauffeur service          # optional — hero/meta tagline (EN)
VITE_SITE_TAGLINE_AR=تاكسي فاخر ٢٤/٧                    # optional — hero/meta tagline (AR)

VITE_SITE_PHONE=+966551796487                           # optional — E.164 phone (tel: links)
VITE_SITE_WHATSAPP=966551796487                         # optional — digits only (wa.me link)
VITE_SITE_EMAIL=admin@mazarat-sa.online                # optional — public contact email

VITE_SITE_ADDRESS_EN=Jeddah, Saudi Arabia               # optional — postal address (EN)
VITE_SITE_ADDRESS_AR=جدة، المملكة العربية السعودية      # optional — postal address (AR)
VITE_SITE_CITY=Jeddah                                   # optional
VITE_SITE_REGION=Makkah Province                        # optional
VITE_SITE_COUNTRY=SA                                    # optional — ISO 3166-1 alpha-2
VITE_SITE_LAT=21.4858                                   # optional — LocalBusiness JSON-LD
VITE_SITE_LNG=39.1925                                   # optional — LocalBusiness JSON-LD
VITE_SITE_HOURS_EN=24/7                                 # optional
VITE_SITE_HOURS_AR=٢٤ ساعة / ٧ أيام                     # optional
VITE_SITE_CURRENCY=SAR                                  # optional — ISO 4217
VITE_SITE_TIMEZONE=Asia/Riyadh                          # optional — IANA TZ
VITE_SITE_OG_IMAGE=/og-cover.jpg                        # optional — absolute or /path
VITE_SITE_LOGO=/logo.png                                # optional

VITE_SITE_TWITTER=                                      # optional — full URL
VITE_SITE_INSTAGRAM=                                    # optional
VITE_SITE_FACEBOOK=                                     # optional
VITE_SITE_TIKTOK=                                       # optional
VITE_SITE_YOUTUBE=                                      # optional
VITE_SITE_LINKEDIN=                                     # optional


# ------------------------------------------------------------------ #
# DATABASE  (managed by Lovable Cloud — do not edit locally)
# ------------------------------------------------------------------ #
SUPABASE_DB_URL=postgresql://...                        # required — auto-provisioned by Lovable Cloud


# ------------------------------------------------------------------ #
# SUPABASE  (Lovable Cloud backend — auto-injected on deploy)
# ------------------------------------------------------------------ #
VITE_SUPABASE_URL=https://<project>.supabase.co         # required — client + SSR
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...             # required — client anon/publishable key
VITE_SUPABASE_PROJECT_ID=<project-ref>                  # required — used by generated types
SUPABASE_URL=https://<project>.supabase.co              # required — server functions
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...                  # required — server functions (with-user client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...                 # required — admin/webhook writes only


# ------------------------------------------------------------------ #
# AUTHENTICATION
# ------------------------------------------------------------------ #
# Auth is handled by Supabase Auth (session cookies + JWT). No extra
# env vars are required in the app; OAuth providers are configured in
# the Lovable Cloud backend console, not in .env.


# ------------------------------------------------------------------ #
# EMAIL  (Lovable managed email — no SMTP creds needed)
# ------------------------------------------------------------------ #
# Delivery is handled by Lovable's managed email API using LOVABLE_API_KEY.
# The sender domain is configured in Cloud → Emails. No variables required.


# ------------------------------------------------------------------ #
# WHATSAPP
# ------------------------------------------------------------------ #
WHATSAPP_PROVIDER_KEY=                                  # optional — enables outbound WhatsApp notifications (queue processor)


# ------------------------------------------------------------------ #
# AI  (Lovable AI Gateway)
# ------------------------------------------------------------------ #
LOVABLE_API_KEY=lov_...                                 # required — auto-provisioned; used by ai-generators + managed email


# ------------------------------------------------------------------ #
# STORAGE
# ------------------------------------------------------------------ #
# Buckets (customer-documents, fleet-documents, media-library) live in
# Lovable Cloud storage. No env vars — access uses SUPABASE_* above.


# ------------------------------------------------------------------ #
# MAPS
# ------------------------------------------------------------------ #
VITE_MAPS_PROVIDER_KEY=                                 # optional — enables interactive maps (not required for current build)


# ------------------------------------------------------------------ #
# ANALYTICS
# ------------------------------------------------------------------ #
VITE_GA_MEASUREMENT_ID=                                 # optional — Google Analytics 4 (G-XXXXXXXXXX)
VITE_PLAUSIBLE_DOMAIN=                                  # optional — Plausible analytics domain


# ------------------------------------------------------------------ #
# CRON  (queue processor + scheduled jobs)
# ------------------------------------------------------------------ #
CRON_SECRET=                                            # optional — shared secret to authenticate /api/public cron callers


# ------------------------------------------------------------------ #
# SECURITY
# ------------------------------------------------------------------ #
SESSION_SECRET=                                         # optional — 64+ char random string for signed cookies (generate via `openssl rand -hex 32`)
WEBHOOK_SIGNING_SECRET=                                 # optional — HMAC secret shared with external webhook senders


# ------------------------------------------------------------------ #
# SEO
# ------------------------------------------------------------------ #
VITE_GSC_VERIFICATION=                                  # optional — Google Search Console meta tag value
VITE_BING_VERIFICATION=                                 # optional — Bing Webmaster meta tag value
