# Copy to .env for local work. On Hostinger set these in the app's environment variables instead.

# Public address of the site (no trailing slash). Used for canonicals, sitemaps and robots.txt.
VITE_SITE_URL=https://taxi-omra.com

# MySQL / MariaDB connection (create the database in hPanel first).
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
# ...or the separate form:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Only needed when running `npm run db:setup` (creates/updates the admin login):
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-long-password

# Optional overrides of the contact details in src/lib/site-info.ts
# VITE_SITE_PHONE=+966551796487
# VITE_SITE_WHATSAPP=966551796487
# VITE_SITE_EMAIL=info@taxi-omra.com
